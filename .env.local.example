# =============================================
# SUPABASE - Configuracao
# =============================================

# URL do projeto Supabase (encontrado em Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publica (anon key) - segura para uso no browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave de servico (service_role) - NUNCA expor no frontend
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# =============================================
# CONFIGURACAO DA APLICACAO
# =============================================
NEXT_PUBLIC_APP_NAME=AVP System
