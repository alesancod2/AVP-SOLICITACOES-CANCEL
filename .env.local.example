# =============================================
# CONFIGURACAO GOOGLE SHEETS API
# =============================================

# ID da planilha (encontrado na URL da planilha)
GOOGLE_SPREADSHEET_ID=seu-spreadsheet-id-aqui

# Credenciais da Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-email@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# =============================================
# AUTENTICACAO
# =============================================

# Secret para tokens JWT (gere um valor seguro para producao)
JWT_SECRET=avp-system-change-this-to-a-secure-random-string

# =============================================
# CONFIGURACAO DA APLICACAO
# =============================================
NEXT_PUBLIC_APP_NAME=AVP System
